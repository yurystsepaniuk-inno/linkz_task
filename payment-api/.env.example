PORT=3003
CORS_ORIGIN=http://localhost:3002

WEBHOOK_SECRET=supersecretwebhookkey_change_in_production
API_KEY=supersecretapikey_change_in_production
RESERVATION_API_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3002
# Seat price (USD). payment-api is the SINGLE source of truth for seat pricing
# across the system: reservation-api does not carry its own copy. The price is
# resolved here on createSession and echoed back in the response so the caller
# can write its audit row from the same value.
RESERVATION_AMOUNT=10.00

# payment-api's *own* Postgres database, on its own container/port. The
# reservation-api points at a separate database (host:5432, db `reservations`);
# the two services cannot query each other's tables. This mirrors the
# production database-per-service topology where each would talk to its own
# RDS instance.
DB_HOST=localhost
DB_PORT=5433
DB_USER=app
DB_PASSWORD=app
DB_NAME=payments

# OpenTelemetry — same convention as reservation-api/.env.example. The
# Collector is brought up by `docker compose --profile observability up`.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_DISABLED=1

# Pino log level + pretty-print toggle.
LOG_LEVEL=info
# PINO_PRETTY=1
