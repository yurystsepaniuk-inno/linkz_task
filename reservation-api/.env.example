PORT=3000
CORS_ORIGIN=http://localhost:3001

DB_HOST=localhost
DB_PORT=5432
DB_USER=app
DB_PASSWORD=app
DB_NAME=reservations

# Clerk — backend verifies short-lived session tokens with the secret key.
# Get it from the Clerk Dashboard → API keys (https://dashboard.clerk.com/~/api-keys).
# IMPORTANT: do NOT commit real keys. Copy this file to `.env` and fill in
# the values from the Clerk dashboard locally.
CLERK_SECRET_KEY=sk_test_REPLACE_ME_WITH_YOUR_CLERK_SECRET_KEY
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME_WITH_YOUR_CLERK_PUBLISHABLE_KEY

WEBHOOK_SECRET=supersecretwebhookkey_change_in_production

PAYMENT_API_URL=http://localhost:3003
PAYMENT_API_KEY=supersecretapikey_change_in_production
# NOTE: there is no RESERVATION_AMOUNT here on purpose — payment-api is the
# single source of truth for seat pricing, and the createSession response
# echoes the resolved amount back to us for the audit row.

# OpenTelemetry — points the Node SDK at the local Collector. When running
# the app on the host (npm run start:dev) the Collector is reachable on
# localhost; when both run inside docker-compose, set this to
# http://otel-collector:4318. Set OTEL_DISABLED=1 to short-circuit the SDK
# entirely (useful for one-off scripts that don't need a Collector).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_DISABLED=1

# Pino log level + pretty-print toggle. PINO_PRETTY=1 emits colorized
# human-readable output for local dev; leave unset in production so Loki
# gets raw JSON.
LOG_LEVEL=info
# PINO_PRETTY=1
